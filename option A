void PrintElement(Element* molecule)
{
    cout << setw(16) << left << "\n\tAtomic #" << " : " << molecule->AtomicNumber;
    cout << setw(16) << left << "\n\tSymbol" << " : " << molecule->Symbol;
    cout << setw(16) << left << "\n\tName" << " : "  << molecule->Name;
    cout << setw(16) << left << "\n\tState type" << " : ";
    DisplayStateType(molecule->StateType);
    cout << setw(16) << left << "\n\tGroup #" << " : " << molecule->GroupNumber;
    cout << setw(16) << left << "\n\tPeriod #" << " : " << molecule->PeriodNumber;
    cout << setw(16) << left << "\n\tBlock type" << " : ";
    DisplayBlockType(molecule->BlockType);
    cout << setw(16) << left << "\n\tMelting point" << " : ";
    DisplayTemperature(molecule->MeltPoint);
    cout << setw(16) << left << "\n\tBoiling Point" << " : " << molecule->BoilPoint;
    DisplayTemperature(molecule->BoilPoint);
    cout << setw(16) << left << "\n\tDiscovery year" << " : " << molecule->DiscoveryYear;
    cout << setw(16) << left << "\n\tDiscovered by" << " : " << molecule->Discoverer;
    cout << endl;
}

void EnterElement(Element* molecule) {
    molecule->AtomicNumber = inputInteger("\n\n\tSpecify the Atomic # :", 1, 118);
    strncpy_s(molecule->Symbol, inputString("\tSpecify the Element Symbol   : ", false).c_str(), sizeof(molecule->Symbol) - 1);
    strncpy_s(molecule->Name, inputString("\tSpecify the Element Name     : ", false).c_str(), sizeof(molecule->Name) - 1);
    molecule->Mass = inputDouble("\tSpecify the Element Mass     : ", 0.0, true);
    molecule->StateType = inputChar("\tSpecify the Element State type (S-solid, L-liquid, G-gas, or U-unknown) : ", static_cast<string>("SLGU"));
    molecule->GroupNumber = inputInteger("\tSpecify the Element Group # (0-unknown or 1...18) : ", 0, 18);
    molecule->PeriodNumber = inputInteger("\tSpecify the Element Period # (0-unknown or 1...7) : ", 0, 7);
    molecule->BlockType = inputChar("\tSpecify the Element Block type (S-sharp, P-principal, D-diffuse, or F-fundamental) : ", static_cast<string>("SPDF"));
    molecule->MeltPoint = inputDouble("\tSpecify the Element Melting Point (celsius degree) : ");
    molecule->BoilPoint = inputDouble("\tSpecify the Element Boiling Point (celsius degree) : ");
    molecule->DiscoveryYear = inputInteger("\tSpecify the Element Discovery Year : ", 0, 2025);
    strncpy_s(molecule->Discoverer, inputString("\tSpecify the Element Discovered By  : ", true).c_str(), sizeof(molecule->Discoverer) - 1);
}

void AddElement(string filename, Element* molecule) {
    ofstream chemistry(filename, ios::app | ios::binary);

    system("cls");
    cout << "\n\tDirectly add an element into the binary data file...";

    if (chemistry.fail()) {
        cout << "\n\tERROR: File, " << filename << ", cannot be found";
        return;
    }

    EnterElement(molecule);

    chemistry.write(reinterpret_cast<char*>(molecule), sizeof(Element));
    cout << "\n\tCONFIRMATION: A new element with Atomic # (" << molecule->AtomicNumber << ") has been added/appended into the binary data file, ";
    cout << filename;

    chemistry.close();
}

void DisplayElement(Element* molecule)
{
    system("cls");

    ifstream chemistry; 
    string filename = inputString("\n\tSpecify a valid binary data file name to retrieve data from: ", false);
    int count = 0;

    chemistry.open(filename, ios::binary | ios::in);

    if (chemistry.fail()) {
        cout << "\n\tERROR: File, " << filename << ", cannot be found";
        return;
    }

    chemistry.read(reinterpret_cast<char*>(molecule), sizeof(Element)); 
    while (!chemistry.eof()) {
        count++;
        PrintElement(molecule); 
        chemistry.read(reinterpret_cast<char*>(molecule), sizeof(Element));
    } 
    cout << "\n\n\tCONFIRMATION: " << count << " record(s) found.";

    chemistry.close();
}

